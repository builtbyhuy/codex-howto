{
  "description": "Optional local, informational lifecycle hooks; inactive until package installation and trust.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/context.cjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/hooks/context.cjs\"",
            "timeout": 10,
            "statusMessage": "Loading fixture review context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__review_fixture_readme$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/context.cjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/hooks/context.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking fixture result context"
          }
        ]
      }
    ]
  }
}

